   "source": [
    \"\"\"\\n",
    "Module: Extended Research Questions Analysis\\n",
    "Purpose: Comprehensive statistical analysis with confidence intervals\\n",
    "\"\"\"\\n",
    "\\n",
    "print(\"\\n\" + \"=\" * 80)\\n",
    "print(\"SECTION 9: EXTENDED RESEARCH QUESTIONS ANALYSIS\")\\n",
    "print(\"=\" * 80)\\n",
    "\\n",
    "# Prepare data\\n",
    "analysis_df = df_processed.copy()\\n",
    "\\n",
    "# =============================================================================\\n",
    "# RQ1 EXTENDED: Spearman Correlation with Confidence Intervals\\n",
    "# =============================================================================\\n",
    "print(\"\\n\" + \"=\" * 60)\\n",
    "print(\"RQ1: Digital Infrastructure → E-Government Maturity\")\\n",
    "print(\"=\" * 60)\\n",
    "\\n",
    "# Spearman correlation with confidence interval\\n",
    "rho, p_value = spearmanr(analysis_df['DII'], analysis_df['EMRI_Score'])\\n",
    "\\n",
    "# Fisher Z-transform for CI\\n",
    "n = len(analysis_df)\\n",
    "z = np.arctanh(rho)\\n",
    "se = 1 / np.sqrt(n - 3)\\n",
    "z_crit = 1.96  # 95% CI\\n",
    "ci_lower = np.tanh(z - z_crit * se)\\n",
    "ci_upper = np.tanh(z + z_crit * se)\\n",
    "\\n",
    "print(f\"Spearman Correlation:\")\\n",
    "print(f\"  ρ = {rho:.4f}\")\\n",
    "print(f\"  95% CI: [{ci_lower:.4f}, {ci_upper:.4f}]\")\\n",
    "print(f\"  p-value: {p_value:.2e}\")\\n",
    "print(f\"  Decision: {'REJECT' if p_value < 0.05 else 'FAIL TO REJECT'} H₀\")\\n",
    "\\n",
    "# Permutation test for robustness\\n",
    "def permutation_correlation(x, y, n_perm=1000):\\n",
    "    observed = spearmanr(x, y)[0]\\n",
    "    permuted = []\\n",
    "    for _ in range(n_perm):\\n",
    "        y_shuffled = np.random.permutation(y)\\n",
    "        permuted.append(spearmanr(x, y_shuffled)[0])\\n",
    "    p_perm = np.mean([abs(p) >= abs(observed) for p in permuted])\\n",
    "    return observed, p_perm\\n",
    "\\n",
    "obs_rho, p_perm = permutation_correlation(\\n",
    "    analysis_df['DII'].values, analysis_df['EMRI_Score'].values, n_perm=1000\\n",
    ")\\n",
    "print(f\"\\nPermutation Test (n=1000):\")\\n",
    "print(f\"  Permutation p-value: {p_perm:.4f}\")\\n",
    "\\n",
    "# =============================================================================\\n",
    "# RQ2 EXTENDED: Heterogeneous Treatment Effects by Clusters\\n",
    "# =============================================================================\\n",
    "print(\"\\n\" + \"=\" * 60)\\n",
    "print(\"RQ2: Developed vs Developing Economies\")\\n",
    "print(\"=\" * 60)\\n",
    "\\n",
    "# Mann-Whitney U test\\n",
    "developed = analysis_df[analysis_df['Economy_Status'] == 'Developed']['EMRI_Score']\\n",
    "developing = analysis_df[analysis_df['Economy_Status'] == 'Developing']['EMRI_Score']\\n",
    "\\n",
    "u_stat, p_mw = mannwhitneyu(developed, developing, alternative='two-sided')\\n",
    "\\n",
    "# Effect size\\n",
    "n1, n2 = len(developed), len(developing)\\n",
    "r_effect = 1 - (2 * u_stat) / (n1 * n2)\\n",
    "\\n",
    "# Cliff's delta\\n",
    "def cliffs_delta(x, y):\\n",
    "    x, y = np.array(x), np.array(y)\\n",
    "    dominance = 0\\n",
    "    for xi in x:\\n",
    "        for yi in y:\\n",
    "            if xi > yi:\\n",
    "                dominance += 1\\n",
    "            elif xi < yi:\\n",
    "                dominance -= 1\\n",
    "    return dominance / (len(x) * len(y))\\n",
    "\\n",
    "cliff_d = cliffs_delta(developed.values, developing.values)\\n",
    "\\n",
    "print(f\"Mann-Whitney U Test:\")\\n",
    "print(f\"  U statistic: {u_stat:.1f}\")\\n",
    "print(f\"  p-value: {p_mw:.2e}\")\\n",
    "print(f\"  Rank-biserial r: {r_effect:.4f} ({'Large' if abs(r_effect) > 0.5 else 'Medium' if abs(r_effect) > 0.3 else 'Small'} effect)\")\\n",
    "print(f\"  Cliff's δ: {cliff_d:.4f}\")\\n",
    "print(f\"  Decision: {'REJECT' if p_mw < 0.05 else 'FAIL TO REJECT'} H₀\")\\n",
    "\\n",
    "# Descriptive comparison\\n",
    "print(f\"\\nDescriptive Statistics:\")\\n",
    "print(f\"  Developed - Mean: {developed.mean():.2f}, Median: {developed.median():.2f}, SD: {developed.std():.2f}\")\\n",
    "print(f\"  Developing - Mean: {developing.mean():.2f}, Median: {developing.median():.2f}, SD: {developing.std():.2f}\")\\n",
    "print(f\"  Difference (Cohen's d): {(developed.mean() - developing.mean()) / np.sqrt((developed.var() + developing.var()) / 2):.4f}\")\\n",
    "\\n",
    "# =============================================================================\\n",
    "# RQ3 EXTENDED: Multiple Regression with VIF\\n",
    "# =============================================================================\\n",
    "print(\"\\n\" + \"=\" * 60)\\n",
    "print(\"RQ3: Predictive Modeling with Multicollinearity Check\")\\n",
    "print(\"=\" * 60)\\n",
",
    "\n",
    "# Prepare data for regression\\n",
    "reg_features = ['DII', 'HCI', 'ESI', 'GEI', 'SRI', 'PSI', 'SSI']\\n",
    "X_reg = analysis_df[reg_features]\\n",
    "y_reg = analysis_df['EMRI_Score']\\n",
    "\\n",
    "# Calculate VIF\\n",
    "X_reg_const = sm.add_constant(X_reg)\\n",
    "vif_data = pd.DataFrame()\\n",
    "vif_data[\"feature\"] = X_reg.columns\\n",
    "vif_data[\"VIF\"] = [variance_inflation_factor(X_reg_const.values, i+1) for i in range(len(X_reg.columns))]\\n",
    "\\n",
    "print(f\"\\nVariance Inflation Factors (VIF):\")\\n",
    "print(vif_data.to_string(index=False))\\n",
    "\\n",
    "# OLS regression\\n",
    "ols_model = sm.OLS(y_reg, X_reg_const).fit()\\n",
    "print(f\"\\nOLS Regression Summary:\")\\n",
    "print(f\"  R-squared: {ols_model.rsquared:.4f}\")\\n",
    "print(f\"  Adjusted R-squared: {ols_model.rsquared_adj:.4f}\")\\n",
    "print(f\"  F-statistic: {ols_model.fvalue:.2f} (p = {ols_model.f_pvalue:.2e})\")\\n",
    "print(f\"  Durbin-Watson: {durbin_watson(ols_model.resid):.4f}\")\\n",
    "\\n",
    "print(f\"\\nCoefficients:\")\\n",
    "for feat, coef, pval in zip(ols_model.params.index, ols_model.params.values, ols_model.pvalues.values):\\n",
    "    sig = \"***\" if pval < 0.001 else \"**\" if pval < 0.01 else \"*\" if pval < 0.05 else \"\"\\n",
    "    print(f\"  {feat:15s}: {coef:8.4f} (p = {pval:.4f}) {sig}\")\\n",
    "\\n",
    "# Steiger's Z test comparing simple vs full model\\n",
    "# Simple model: DII only\\n",
    "X_simple = sm.add_constant(analysis_df['DII'])\\n",
    "simple_model = sm.OLS(y_reg, X_simple).fit()\\n",
    "\\n",
    "r_simple = np.sqrt(simple_model.rsquared)\\n",
    "r_full = np.sqrt(ols_model.rsquared)\\n",
    "\\n",
    "# Steiger's Z\\n",
    "z1 = 0.5 * np.log((1 + r_simple) / (1 - r_simple))\\n",
    "z2 = 0.5 * np.log((1 + r_full) / (1 - r_full))\\n",
    "se_steiger = np.sqrt(2 / (n - 3))\\n",
    "z_steiger = (z2 - z1) / se_steiger\\n",
    "p_steiger = 1 - norm.cdf(z_steiger)\\n",
    "\\n",
    "print(f\"\\nSteiger's Z-Test (Simple vs Full Model):\")\\n",
    "print(f\"  Simple model R: {r_simple:.4f}\")\\n",
    "print(f\"  Full model R: {r_full:.4f}\")\\n",
    "print(f\"  Z statistic: {z_steiger:.4f}\")\\n",
    "print(f\"  p-value: {p_steiger:.4f}\")\\n",
    "print(f\"  Decision: {'REJECT' if p_steiger < 0.05 else 'FAIL TO REJECT'} H₀\")\\n",
    "\\n",
    "# =============================================================================\\n",
    "# RQ4 EXTENDED: Comprehensive Model Comparison\\n",
