    "<a id='section-7'></a>\\n",
    "## Section 7: Weight-Sensitivity Robustness Testing\\n",
    "\\n",
    "Test model robustness across different EMRI weight configurations."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    \"\"\"\\n",
    "Module: Weight-Sensitivity Analysis\\n",
    "Purpose: Robustness testing across EMRI weight configurations\\n",
    "\"\"\"\\n",
    "\\n",
    "class WeightSensitivityAnalyzer:\\n",
    "    \"\"\"Test model sensitivity to EMRI weight configurations.\"\"\"\\n",
    "    \\n",
    "    def __init__(self, config: EMRIConfig = CONFIG):\\n",
    "        self.config = config\\n",
    "        self.logger = logging.getLogger(__name__)\\n",
    "    \\n",
    "    def generate_weight_variations(self, n_variations: int = 10) -> List[Dict]:\\n",
    "        \"\"\"Generate variations of EMRI weights for sensitivity testing.\"\"\"\\n",
    "        base_weights = self.config.EMRI_WEIGHTS\\n",
    "        variations = []\\n",
    "        \\n",
    "        # Add base configuration\\n",
    "        variations.append(base_weights)\\n",
    "        \\n",
    "        np.random.seed(self.config.RANDOM_STATE)\\n",
    "        \\n",
    "        for i in range(n_variations - 1):\\n",
    "            # Generate random perturbations\\n",
    "            perturbation = np.random.dirichlet(np.ones(len(base_weights)))\\n",
    "            new_weights = dict(zip(base_weights.keys(), perturbation))\\n",
    "            variations.append(new_weights)\\n",
    "        \\n",
    "        return variations\\n",
    "    \\n",
    "    def compute_emri_with_weights(self, df: pd.DataFrame, weights: Dict) -> pd.Series:\\n",
    "        \"\"\"Compute EMRI score with custom weights.\"\"\"\\n",
    "        emri_score = sum(df[index] * weight for index, weight in weights.items())\\n",
    "        return emri_score\\n",
    "    \\n",
    "    def test_robustness(\\n",
    "        self, \\n",
    "        df: pd.DataFrame, \\n",
    "        base_model,\\n",
    "        n_variations: int = 10\\n",
    "    ) -> pd.DataFrame:\\n",
    "        \"\"\"Test model robustness across weight variations.\"\"\"\\n",
    "        variations = self.generate_weight_variations(n_variations)\\n",
    "        results = []\\n",
    "        \\n",
    "        for i, weights in enumerate(variations):\\n",
    "            # Compute EMRI with these weights\\n",
    "            df_test = df.copy()\\n",
    "            df_test['EMRI_Score_Var'] = self.compute_emri_with_weights(df_test, weights)\\n",
    "            \\n",
    "            # Create binary target\\n",
    "            threshold = df_test['EMRI_Score_Var'].median()\\n",
    "            y_var = (df_test['EMRI_Score_Var'] >= threshold).astype(int)\\n",
    "            \\n",
    "            # Get features\\n",
    "            X_var = df_test[list(self.config.EMRI_WEIGHTS.keys())]\\n",
    "            \\n",
    "            # Cross-validate\\n",
    "            from sklearn.model_selection import cross_val_score\\n",
    "            scores = cross_val_score(base_model, X_var, y_var, cv=5, scoring='roc_auc')\\n",
    "            \\n",
    "            results.append({\\n",
    "                'variation_id': i,\\n",
    "                'mean_auc': scores.mean(),\\n",
    "                'std_auc': scores.std(),\\n",
    "                'is_baseline': i == 0,\\n",
    "                'weights': weights\\n",
    "            })\\n",
    "        \\n",
    "        return pd.DataFrame(results)\\n",
    "\\n",
    "\\n",
    "print(\"\\n\" + \"=\" * 80)\\n",
    "print(\"SECTION 7: WEIGHT-SENSITIVITY ROBUSTNESS TESTING\")\\n",
    "print(\"=\" * 80)\\n",
    "\\n",
    "# Run sensitivity analysis\\n",
    "sensitivity_analyzer = WeightSensitivityAnalyzer()\\n",
    "base_rf = trained_models['RandomForest']\\n",
    "\\n",
    "sensitivity_results = sensitivity_analyzer.test_robustness(df_processed, base_rf, n_variations=10)\\n",
    "\\n",
    "print(\"\\nSensitivity Analysis Results:\")\\n",
    "print(sensitivity_results[['variation_id', 'mean_auc', 'std_auc', 'is_baseline']].round(4).to_string(index=False))\\n",
    "\\n",
    "baseline_auc = sensitivity_results[sensitivity_results['is_baseline']]['mean_auc'].iloc[0]\\n",
    "mean_auc = sensitivity_results['mean_auc'].mean()\\n",
    "std_auc = sensitivity_results['mean_auc'].std()\\n",
    "\\n",
    "print(f\"\\nRobustness Summary:\")\\n",
    "print(f\"  Baseline AUC: {baseline_auc:.4f}\")\\n",
    "print(f\"  Mean AUC across variations: {mean_auc:.4f}\")\\n",
    "print(f\"  Std Dev: {std_auc:.4f}\")\\n",
    "print(f\"  Robustness Score: {1 - (std_auc / mean_auc):.4f} (1 = perfectly robust)\")\\n",
    "\\n",
    "# Visualization\\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\\n",
    "colors = ['red' if x else 'steelblue' for x in sensitivity_results['is_baseline']]\\n",
    "ax.bar(sensitivity_results['variation_id'], sensitivity_results['mean_auc'], \\n",
    "       yerr=sensitivity_results['std_auc'], color=colors, alpha=0.7, capsize=5)\\n",
    "ax.axhline(y=baseline_auc, color='red', linestyle='--', linewidth=2, label='Baseline')\\n",
    "ax.set_xlabel('Weight Variation ID', fontsize=11)\\n",
    "ax.set_ylabel('Mean AUC', fontsize=11)\\n",
    "ax.set_title('Weight-Sensitivity Analysis: Model Robustness Across Weight Configurations', \\n",
    "             fontsize=12, fontweight='bold')\\n",
    "ax.legend()\\n",
    "ax.grid(True, alpha=0.3, axis='y')\\n",
    "plt.tight_layout()\\n",
    "plt.savefig('../figures/weight_sensitivity_analysis.png', dpi=300, bbox_inches='tight')\\n",
    "plt.show()\\n",
    "\\n",
    "print(\"\\n✓ Weight-sensitivity analysis complete\")"
   ]
  },
