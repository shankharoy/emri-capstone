    \"\"\"\\n",
    "Module: Model Training and Stacking Ensemble\\n",
    "Purpose: Production model training with calibrated voting ensemble\\n",
    "\"\"\"\\n",
    "\\n",
    "class ModelTrainingPipeline:\\n",
    "    \"\"\"Production model training with stacking ensemble.\"\"\"\\n",
    "    \\n",
    "    def __init__(self, config: EMRIConfig = CONFIG):\\n",
    "        self.config = config\\n",
    "        self.logger = logging.getLogger(__name__)\\n",
    "        self.trained_models = {}\\n",
    "        self.metrics = {}\\n",
    "    \\n",
    "    def split_data(\\n",
    "        self, \\n",
    "        X: pd.DataFrame, \\n",
    "        y: pd.Series,\\n",
    "        test_size: float = 0.2\\n",
    "    ) -> Tuple:\\n",
    "        \"\"\"Stratified train-test split.\"\"\"\\n",
    "        return train_test_split(\\n",
    "            X, y, \\n",
    "            test_size=test_size, \\n",
    "            random_state=self.config.RANDOM_STATE,\\n",
    "            stratify=y\\n",
    "        )\\n",
    "    \\n",
    "    def train_base_models(\\n",
    "        self, \\n",
    "        X_train: pd.DataFrame, \\n",
    "        y_train: pd.Series,\\n",
    "        optimized_models: Dict = None\\n",
    "    ) -> Dict:\\n",
    "        \"\"\"Train all base models.\"\"\"\\n",
    "        models = {}\\n",
    "        \\n",
    "        # Use optimized models if available\\n",
    "        if optimized_models:\\n",
    "            if 'RandomForest' in optimized_models:\\n",
    "                models['RandomForest'] = optimized_models['RandomForest']['model']\\n",
    "            if 'GradientBoosting' in optimized_models:\\n",
    "                models['GradientBoosting'] = optimized_models['GradientBoosting']['model']\\n",
    "        else:\\n",
    "            models['RandomForest'] = RandomForestClassifier(\\n",
    "                n_estimators=200, max_depth=10, random_state=self.config.RANDOM_STATE\\n",
    "            )\\n",
    "            models['GradientBoosting'] = GradientBoostingClassifier(\\n",
    "                n_estimators=200, learning_rate=0.1, random_state=self.config.RANDOM_STATE\\n",
    "            )\\n",
    "        \\n",
    "        # Additional models\\n",
    "        models['LogisticRegression'] = LogisticRegression(\\n",
    "            max_iter=1000, random_state=self.config.RANDOM_STATE, class_weight='balanced'\\n",
    "        )\\n",
    "        models['SVM'] = SVC(\\n",
    "            kernel='rbf', probability=True, random_state=self.config.RANDOM_STATE, class_weight='balanced'\\n",
    "        )\\n",
    "        \\n",
    "        # Train all models\\n",
    "        for name, model in models.items():\\n",
    "            self.logger.info(f\"Training {name}...\")\\n",
    "            model.fit(X_train, y_train)\\n",
    "            self.trained_models[name] = model\\n",
    "        \\n",
    "        return self.trained_models\\n",
    "    \\n",
    "    def evaluate_models(\\n",
    "        self, \\n",
    "        models: Dict, \\n",
    "        X_test: pd.DataFrame, \\n",
    "        y_test: pd.Series\\n",
    "    ) -> pd.DataFrame:\\n",
    "        \"\"\"Evaluate all models on test set.\"\"\"\\n",
    "        results = []\\n",
    "        \\n",
    "        for name, model in models.items():\\n",
    "            y_pred = model.predict(X_test)\\n",
    "            y_pred_proba = model.predict_proba(X_test)[:, 1]\\n",
    "            \\n",
    "            results.append({\\n",
    "                'Model': name,\\n",
    "                'Accuracy': accuracy_score(y_test, y_pred),\\n",
    "                'Precision': precision_score(y_test, y_pred, zero_division=0),\\n",
    "                'Recall': recall_score(y_test, y_pred, zero_division=0),\\n",
    "                'F1': f1_score(y_test, y_pred, zero_division=0),\\n",
    "                'AUC': roc_auc_score(y_test, y_pred_proba),\\n",
    "                'MCC': matthews_corrcoef(y_test, y_pred)\\n",
    "            })\\n",
    "        \\n",
    "        return pd.DataFrame(results)\\n",
    "    \\n",
    "    def create_stacking_ensemble(\\n",
    "        self, \\n",
    "        models: Dict, \\n",
    "        X_train: pd.DataFrame, \\n",
    "        y_train: pd.Series,\\n",
    "        meta_model: str = 'logistic'\\n",
    "    ) -> StackingClassifier:\\n",
    "        \"\"\"Create stacking ensemble with calibrated meta-learner.\"\"\"\\n",
    "        # Prepare estimators for stacking\\n",
    "        estimators = [(name, model) for name, model in models.items()]\\n",
    "        \\n",
    "        # Meta-learner\\n",
    "        if meta_model == 'logistic':\\n",
    "            final_estimator = LogisticRegression(max_iter=1000, random_state=self.config.RANDOM_STATE)\\n",
    "        else:\\n",
    "            final_estimator = RandomForestClassifier(n_estimators=100, random_state=self.config.RANDOM_STATE)\\n",
    "        \\n",
    "        # Create stacking classifier\\n",
    "        stacking = StackingClassifier(\\n",
    "            estimators=estimators,\\n",
    "            final_estimator=final_estimator,\\n",
    "            cv=5,\\n",
    "            passthrough=False,\\n",
    "            n_jobs=-1\\n",
    "        )\\n",
    "        \\",
    "        stacking.fit(X_train, y_train)\\n",
    "        return stacking\\n",
    "    \\n",
    "    def calibrate_probabilities(\\n",
    "        self, \\n",
    "        model, \\n",
    "        X_train: pd.DataFrame, \\n",
    "        y_train: pd.Series\\n",
    "    ):\\n",
    "        \"\"\"Calibrate model probabilities using isotonic regression.\"\"\"\\n",
    "        calibrated = CalibratedClassifierCV(\\n",
    "            model, method='isotonic', cv=5\\n",
    "        )\\n",
    "        calibrated.fit(X_train, y_train)\\n",
    "        return calibrated\\n",
    "    \\n",
    "    def run_full_training(\\n",
    "        self, \\n",
    "        X: pd.DataFrame, \\n",
    "        y: pd.Series,\\n",
    "        optimized_models: Dict = None\\n",
    "    ) -> Dict:\\n",
    "        \"\"\"Execute full training pipeline.\"\"\"\\n",
    "        print(\"\\n\" + \"=\" * 80)\\n",
    "        print(\"SECTION 5: MODEL TRAINING & ENSEMBLE\")\\n",
    "        print(\"=\" * 80)\\n",
    "        \\n",
    "        # Split data\\n",
    "        X_train, X_test, y_train, y_test = self.split_data(X, y)\\n",
    "        print(f\"\\nData split: {len(X_train)} train, {len(X_test)} test\")\\n",
    "        \\n",
    "        # Train base models\\n",
    "        print(\"\\nTraining base models...\")\\n",
