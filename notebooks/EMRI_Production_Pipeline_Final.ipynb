    "<a id='section-2'></a>\\n",
    "## Section 2: Data Ingestion - Multi-Source Pipeline\\n",
    "\\n",
    "Load and merge data from World Bank WDI with automated quality checks."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    \"\"\"\\n",
    "Module: Data Ingestion Pipeline\\n",
    "Purpose: Production-grade data loading with validation and quality checks\\n",
    "\"\"\"\\n",
    "\\n",
    "class DataIngestionPipeline:\\n",
    "    \"\"\"Production data ingestion with quality validation.\"\"\"\\n",
    "    \\n",
    "    WDI_INDICATORS = {\\n",
    "        'IT.NET.USER.ZS': 'Internet_Users_Pct',\\n",
    "        'NY.GDP.PCAP.CD': 'GDP_Per_Capita',\\n",
    "        'NY.GNP.PCAP.CD': 'GNI_Per_Capita',\\n",
    "        'SL.TLF.CACT.FE.ZS': 'Female_Labor_Participation_Pct',\\n",
    "        'SP.URB.TOTL.IN.ZS': 'Urban_Population_Pct'\\n",
    "    }\\n",
    "    \\n",
    "    DEVELOPED_COUNTRIES = [\\n",
    "        'USA', 'GBR', 'DEU', 'JPN', 'FRA', 'ITA', 'CAN', 'KOR', 'ESP', 'AUS',\\n",
    "        'NLD', 'CHE', 'BEL', 'SWE', 'AUT', 'NOR', 'IRL', 'DNK', 'SGP', 'FIN',\\n",
    "        'NZL', 'LUX', 'ISR', 'CZE', 'SVN', 'PRT', 'GRC', 'HRV', 'EST', 'SVK',\\n",
    "        'LTU', 'LVA', 'CYP', 'MLT', 'ISL'\\n",
    "    ]\\n",
    "    \\n",
    "    def __init__(self, config: EMRIConfig = CONFIG):\\n",
    "        self.config = config\\n",
    "        self.logger = logging.getLogger(__name__)\\n",
    "        self.raw_data = None\\n",
    "        self.processed_data = None\\n",
    "    \\n",
    "    def load_wdi_panel(self, path: Optional[Path] = None) -> pd.DataFrame:\\n",
    "        \"\"\"Load WDI panel data from CSV.\"\"\"\\n",
    "        if path is None:\\n",
    "            path = self.config.DATA_DIR / \"output\" / \"wdi_panel.csv\"\\n",
    "        \\n",
    "        self.logger.info(f\"Loading WDI data from {path}\")\\n",
    "        \\n",
    "        df = pd.read_csv(path)\\n",
    "        \\n",
    "        # Data quality checks\\n",
    "        assert 'country_iso3' in df.columns, \"Missing country_iso3 column\"\\n",
    "        assert 'year' in df.columns, \"Missing year column\"\\n",
    "        assert 'indicator_code' in df.columns, \"Missing indicator_code column\"\\n",
    "        assert 'value' in df.columns, \"Missing value column\"\\n",
    "        \\n",
    "        self.logger.info(f\"Loaded {len(df)} rows, {df['indicator_code'].nunique()} indicators\")\\n",
    "        return df\\n",
    "    \\n",
    "    def transform_to_wide(self, df: pd.DataFrame) -> pd.DataFrame:\\n",
    "        \"\"\"Transform from long to wide format.\"\"\"\\n",
    "        # Pivot to wide format\\n",
    "        df_wide = df.pivot_table(\\n",
    "            index=['country_iso3', 'country_name', 'year'],\\n",
    "            columns='indicator_code',\\n",
    "            values='value',\\n",
    "            aggfunc='first'\\n",
    "        ).reset_index()\\n",
    "        \\n",
    "        # Flatten columns\\n",
    "        df_wide.columns.name = None\\n",
    "        df_wide.columns = [str(c) for c in df_wide.columns]\\n",
    "        \\n",
    "        # Rename to descriptive names\\n",
    "        df_wide = df_wide.rename(columns=self.WDI_INDICATORS)\\n",
    "        \\n",
    "        return df_wide\\n",
    "    \\n",
    "    def filter_time_period(self, df: pd.DataFrame, years: List[int]) -> pd.DataFrame:\\n",
    "        \"\"\"Filter to specified years.\"\"\"\\n",
    "        return df[df['year'].isin(years)].copy()\\n",
    "    \\n",
    "    def add_economy_classification(self, df: pd.DataFrame) -> pd.DataFrame:\\n",
    "        \"\"\"Classify economies as Developed or Developing.\"\"\"\\n",
    "        df = df.copy()\\n",
    "        df['Economy_Status'] = df['country_iso3'].apply(\\n",
    "            lambda x: 'Developed' if x in self.DEVELOPED_COUNTRIES else 'Developing'\\n",
    "        )\\n",
    "        return df\\n",
    "    \\n",
    "    def validate_data(self, df: pd.DataFrame) -> Dict[str, Any]:\\n",
    "        \"\"\"Run comprehensive data validation.\"\"\"\\n",
    "        validation_results = {\\n",
    "            'total_rows': len(df),\\n",
    "            'countries': df['country_iso3'].nunique() if 'country_iso3' in df.columns else 0,\\n",
    "            'years': sorted(df['year'].unique().tolist()) if 'year' in df.columns else [],\\n",
    "            'missing_summary': {},\\n",
    "            'completeness': {}\\n",
    "        }\\n",
    "        \\n",
    "        # Check numeric columns\\n",
    "        numeric_cols = [c for c in df.columns if c in self.WDI_INDICATORS.values()]\\n",
    "        for col in numeric_cols:\\n",
    "            missing_count = df[col].isnull().sum()\\n",
    "            missing_pct = missing_count / len(df) * 100\\n",
    "            validation_results['missing_summary'][col] = {\\n",
    "                'missing_count': missing_count,\\n",
    "                'missing_pct': round(missing_pct, 2),\\n",
    "                'completeness': round(100 - missing_pct, 2)\\n",
    "            }\\n",
    "        \\n",
    "        return validation_results\\n",
    "    \\n",
    "    def run_pipeline(self) -> Tuple[pd.DataFrame, Dict]:\\n",
    "        \"\"\"Execute full data ingestion pipeline.\"\"\"\\n",
    "        # Load raw data\\n",
    "        df_long = self.load_wdi_panel()\\n",
    "        \\n",
    "        # Transform to wide\\n",
    "        df_wide = self.transform_to_wide(df_long)\\n",
    "        \\n",
    "        # Filter to training years\\n",
    "        df_train = self.filter_time_period(df_wide, self.config.TRAIN_YEARS)\\n",
    "        \\n",
    "        # Add economy classification\\n",
    "        df_train = self.add_economy_classification(df_train)\\n",
    "        \\n",
    "        # Validate\\n",
    "        validation = self.validate_data(df_train)\\n",
    "        \\n",
    "        self.raw_data = df_train\\n",
    "        self.logger.info(\"Data ingestion complete\")\\n",
    "        \\n",
    "        return df_train, validation\\n",
    "\\n",
    "\\n",
    "# Execute data ingestion\\n",
    "print(\"\\n\" + \"=\" * 80)\\n",
    "print(\"SECTION 2: DATA INGESTION\")\\n",
    "print(\"=\" * 80)\\n",
    "\\n",
    "ingestion = DataIngestionPipeline()\\n",
    "df_raw, validation_report = ingestion.run_pipeline()\\n",
    "\\n",
    "print(f\"\\nData Ingestion Summary:\")\\n",
    "print(f\"  Total Observations: {validation_report['total_rows']:,}\")\\n",
    "print(f\"  Countries: {validation_report['countries']}\")\\n",
    "print(f\"  Years: {validation_report['years']}\")\\n",
    "print(\"\\nData Completeness:\")\\n",
    "for col, stats in validation_report['missing_summary'].items():\\n",
    "    print(f\"  {col:35s}: {stats['completeness']:.1f}% complete\")\\n",
    "\\n",
    "df_raw.head()"
   ]
  },
