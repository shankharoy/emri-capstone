    "        print(f\"  Best CV AUC: {results['GradientBoosting']['best_score']:.4f}\")\\n",
    "        print(f\"  Best params: {results['GradientBoosting']['best_params']}\")\\n",
    "        \\n",
    "        self.optimization_results = results\\n",
    "        return results\\n",
    "\\n",
    "\\n",
    "# Prepare data for optimization\\n",
    "EMRI_FEATURES = list(CONFIG.EMRI_WEIGHTS.keys())\\n",
    "X = df_processed[EMRI_FEATURES].dropna()\\n",
