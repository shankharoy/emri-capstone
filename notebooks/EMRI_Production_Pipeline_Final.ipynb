    \"\"\"\\n",
    "Module: Hyperparameter Optimization\\n",
    "Purpose: Bayesian optimization for production-grade model tuning\\n",
    "\"\"\"\\n",
    "\\n",
    "class HyperparameterOptimizer:\\n",
    "    \"\"\"Production hyperparameter optimization with Bayesian search.\"\"\"\\n",
    "    \\n",
    "    def __init__(self, config: EMRIConfig = CONFIG):\\n",
    "        self.config = config\\n",
    "        self.logger = logging.getLogger(__name__)\\n",
    "        self.best_models = {}\\n",
    "        self.optimization_results = {}\\n",
    "    \\n",
    "    def optimize_random_forest(\\n",
    "        self, \\n",
    "        X: pd.DataFrame, \\n",
    "        y: pd.Series,\\n",
    "        n_iter: int = 50,\\n",
    "        cv_folds: int = 5\\n",
    "    ) -> Dict:\\n",
    "        \"\"\"Optimize Random Forest hyperparameters.\"\"\"\\n",
    "        self.logger.info(f\"Starting RF optimization: {n_iter} iterations\")\\n",
    "        \\n",
    "        rf = RandomForestClassifier(random_state=self.config.RANDOM_STATE)\\n",
    "        \\n",
    "        if SKOPT_AVAILABLE:\\n",
    "            search = BayesSearchCV(\\n",
    "                rf,\\n",
    "                self.config.RF_SEARCH_SPACE,\\n",
    "                n_iter=n_iter,\\n",
    "                cv=StratifiedKFold(n_splits=cv_folds, shuffle=True, random_state=self.config.RANDOM_STATE),\\n",
    "                scoring='roc_auc',\\n",
    "                n_jobs=-1,\\n",
    "                random_state=self.config.RANDOM_STATE,\\n",
    "                verbose=0\\n",
    "            )\\n",
    "        else:\\n",
    "            # Fallback to RandomizedSearchCV\\n",
    "            param_dist = {\\n",
    "                'n_estimators': range(100, 500),\\n",
    "                'max_depth': range(3, 20),\\n",
    "                'min_samples_split': range(2, 20),\\n",
    "                'min_samples_leaf': range(1, 10)\\n",
    "            }\\n",
    "            search = RandomizedSearchCV(\\n",
    "                rf, param_dist, n_iter=n_iter, cv=cv_folds,\\n",
    "                scoring='roc_auc', random_state=self.config.RANDOM_STATE, n_jobs=-1\\n",
    "            )\\n",
    "        \\n",
    "        search.fit(X, y)\\n",
    "        \\n",
    "        results = {\\n",
    "            'best_params': search.best_params_,\\n",
    "            'best_score': search.best_score_,\\n",
    "            'model': search.best_estimator_,\\n",
    "            'cv_results': search.cv_results_ if hasattr(search, 'cv_results_') else None\\n",
    "        }\\n",
    "        \\n",
    "        self.best_models['RandomForest'] = results['model']\\n",
    "        self.logger.info(f\"RF optimization complete. Best CV AUC: {results['best_score']:.4f}\")\\n",
    "        \\n",
    "        return results\\n",
    "    \\n",
    "    def optimize_gradient_boosting(\\n",
    "        self, \\n",
    "        X: pd.DataFrame, \\n",
    "        y: pd.Series,\\n",
    "        n_iter: int = 50,\\n",
    "        cv_folds: int = 5\\n",
    "    ) -> Dict:\\n",
    "        \"\"\"Optimize Gradient Boosting hyperparameters.\"\"\"\\n",
    "        self.logger.info(f\"Starting GB optimization: {n_iter} iterations\")\\n",
    "        \\n",
    "        gb = GradientBoostingClassifier(random_state=self.config.RANDOM_STATE)\\n",
    "        \\n",
    "        if SKOPT_AVAILABLE:\\n",
    "            search = BayesSearchCV(\\n",
    "                gb,\\n",
    "                self.config.GB_SEARCH_SPACE,\\n",
    "                n_iter=n_iter,\\n",
    "                cv=StratifiedKFold(n_splits=cv_folds, shuffle=True, random_state=self.config.RANDOM_STATE),\\n",
    "                scoring='roc_auc',\\n",
    "                n_jobs=-1,\\n",
    "                random_state=self.config.RANDOM_STATE,\\n",
    "                verbose=0\\n",
    "            )\\n",
    "        else:\\n",
    "            param_dist = {\\n",
    "                'n_estimators': range(100, 500),\\n",
    "                'learning_rate': [0.01, 0.05, 0.1, 0.15, 0.2],\\n",
    "                'max_depth': range(3, 10),\\n",
    "                'min_samples_split': range(2, 20)\\n",
    "            }\\n",
    "            search = RandomizedSearchCV(\\n",
    "                gb, param_dist, n_iter=n_iter, cv=cv_folds,\\n",
    "                scoring='roc_auc', random_state=self.config.RANDOM_STATE, n_jobs=-1\\n",
    "            )\\n",
    "        \\n",
    "        search.fit(X, y)\\n",
    "        \\n",
    "        results = {\\n",
    "            'best_params': search.best_params_,\\n",
    "            'best_score': search.best_score_,\\n",
    "            'model': search.best_estimator_,\\n",
    "            'cv_results': search.cv_results_ if hasattr(search, 'cv_results_') else None\\n",
    "        }\\n",
    "        \\n",
    "        self.best_models['GradientBoosting'] = results['model']\\n",
    "        self.logger.info(f\"GB optimization complete. Best CV AUC: {results['best_score']:.4f}\")\\n",
    "        \\n",
    "        return results\\n",
    "    \\n",
    "    def run_full_optimization(\\n",
    "        self, \\n",
    "        X: pd.DataFrame, \\n",
    "        y: pd.Series\\n",
    "    ) -> Dict:\\n",
    "        \"\"\"Run optimization for all models.\"\"\"\\n",
    "        print(\"\\n\" + \"=\" * 80)\\n",
    "        print(\"SECTION 4: HYPERPARAMETER OPTIMIZATION\")\\n",
    "        print(\"=\" * 80)\\n",
    "        \\n",
    "        results = {}\\n",
    "        \\n",
    "        # Optimize Random Forest\\n",
    "        print(\"\\nOptimizing Random Forest...\")\\n",
    "        results['RandomForest'] = self.optimize_random_forest(X, y, n_iter=50)\\n",
    "        print(f\"  Best CV AUC: {results['RandomForest']['best_score']:.4f}\")\\n",
    "        print(f\"  Best params: {results['RandomForest']['best_params']}\")\\n",
    "        \\n",
    "        # Optimize Gradient Boosting\\n",
