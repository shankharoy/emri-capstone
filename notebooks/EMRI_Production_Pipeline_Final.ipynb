   "source": [
    \"\"\"\\n",
    "Module: Advanced Feature Engineering\\n",
    "Purpose: KNN imputation with year-stratification and EMRI index construction\\n",
    "\"\"\"\\n",
    "\\n",
    "class FeatureEngineeringPipeline:\\n",
    "    \"\"\"Production feature engineering pipeline.\"\"\"\\n",
    "    \\n",
    "    def __init__(self, config: EMRIConfig = CONFIG):\\n",
    "        self.config = config\\n",
    "        self.logger = logging.getLogger(__name__)\\n",
    "        self.scaler = None\\n",
    "        self.imputer = None\\n",
    "    \\n",
    "    def knn_impute_year_stratified(\\n",
    "        self, \\n",
    "        df: pd.DataFrame, \\n",
    "        numeric_cols: List[str], \\n",
    "        n_neighbors: int = 5\\n",
    "    ) -> pd.DataFrame:\\n",
    "        \"\"\"\\n",
    "        Apply KNN imputation stratified by year.\\n",
    "        Countries within same year are comparable.\\n",
    "        \"\"\"\\n",
    "        df_imputed = df.copy()\\n",
    "        imputation_log = []\\n",
    "        \\n",
    "        for year in df['year'].unique():\\n",
    "            year_mask = df['year'] == year\\n",
    "            year_data = df.loc[year_mask, numeric_cols].copy()\\n",
    "            \\n",
    "            if year_data.isnull().sum().sum() > 0 and len(year_data.dropna()) > n_neighbors:\\n",
    "                # Standardize before KNN\\n",
    "                scaler_temp = StandardScaler()\\n",
    "                valid_idx = year_data.dropna().index\\n",
    "                \\n",
    "                if len(valid_idx) > n_neighbors:\\n",
    "                    scaler_temp.fit(year_data.loc[valid_idx])\\n",
    "                    year_data_scaled = scaler_temp.transform(year_data)\\n",
    "                    \\n",
    "                    # Apply KNN imputation\\n",
    "                    knn_imputer = KNNImputer(\\n",
    "                        n_neighbors=min(n_neighbors, len(valid_idx)-1),\\n",
    "                        weights='distance',\\n",
    "                        metric='nan_euclidean'\\n",
    "                    )\\n",
    "                    \\n",
    "                    imputed_scaled = knn_imputer.fit_transform(year_data_scaled)\\n",
    "                    imputed_values = scaler_temp.inverse_transform(imputed_scaled)\\n",
    "                    \\n",
    "                    df_imputed.loc[year_mask, numeric_cols] = imputed_values\\n",
    "                    imputation_log.append(f\"Year {year}: {year_data.isnull().sum().sum()} values imputed\")\\n",
    "        \\n",
    "        self.logger.info(f\"KNN imputation complete: {len(imputation_log)} years processed\")\\n",
    "        return df_imputed\\n",
    "    \\n",
    "    def normalize_series(self, series: pd.Series, invert: bool = False) -> pd.Series:\\n",
    "        \"\"\"Apply min-max normalization to 0-100 scale.\"\"\"\\n",
    "        min_val = series.min()\\n",
    "        max_val = series.max()\\n",
    "        \\n",
    "        if max_val == min_val:\\n",
    "            return pd.Series(50, index=series.index)\\n",
    "        \\n",
    "        normalized = (series - min_val) / (max_val - min_val) * 100\\n",
    "        return 100 - normalized if invert else normalized\\n",
    "    \\n",
    "    def construct_emri_indices(self, df: pd.DataFrame) -> pd.DataFrame:\\n",
    "        \"\"\"\\n",
    "        Construct the 7 EMRI dimension indices.\\n",
    "        Uses weighted combinations of available WDI indicators.\\n",
    "        \"\"\"\\n",
    "        df_emri = df.copy()\\n",
    "        \\n",
    "        # 1. Digital Infrastructure Index (DII)\\n",
    "        df_emri['DII'] = (\\n",
    "            self.normalize_series(df_emri['Internet_Users_Pct']) * 0.7 +\\n",
    "            self.normalize_series(df_emri['Urban_Population_Pct']) * 0.3\\n",
    "        )\\n",
    "        \\n",
    "        # 2. Human Capital Index (HCI)\\n",
    "        df_emri['HCI'] = (\\n",
    "            self.normalize_series(np.log1p(df_emri['GDP_Per_Capita'])) * 0.5 +\\n",
    "            self.normalize_series(df_emri['Female_Labor_Participation_Pct']) * 0.5\\n",
    "        )\\n",
    "        \\n",
    "        # 3. Economic Stability Index (ESI)\\n",
    "        df_emri['ESI'] = (\\n",
    "            self.normalize_series(np.log1p(df_emri['GDP_Per_Capita'])) * 0.5 +\\n",
    "            self.normalize_series(np.log1p(df_emri['GNI_Per_Capita'])) * 0.5\\n",
    "        )\\n",
    "        \\n",
    "        # 4. Governance Efficiency Index (GEI)\\n",
    "        df_emri['GEI'] = (\\n",
    "            self.normalize_series(df_emri['Internet_Users_Pct']) * 0.4 +\\n",
    "            self.normalize_series(np.log1p(df_emri['GDP_Per_Capita'])) * 0.4 +\\n",
    "            self.normalize_series(df_emri['Urban_Population_Pct']) * 0.2\\n",
    "        )\\n",
    "        \\n",
    "        # 5. Sustainability Readiness Index (SRI)\\n",
    "        df_emri['SRI'] = (\\n",
    "            self.normalize_series(df_emri['Urban_Population_Pct']) * 0.6 +\\n",
    "            self.normalize_series(df_emri['Internet_Users_Pct']) * 0.4\\n",
    "        )\\n",
    "        \\n",
    "        # 6. Population Scale Index (PSI)\\n",
    "        df_emri['PSI'] = self.normalize_series(np.log1p(df_emri['GNI_Per_Capita']))\\n",
    "        \\n",
    "        # 7. Security Stability Index (SSI)\\n",
    "        gdp_norm = self.normalize_series(np.log1p(df_emri['GDP_Per_Capita']))\\n",
    "        gni_norm = self.normalize_series(np.log1p(df_emri['GNI_Per_Capita']))\\n",
    "        df_emri['SSI'] = ((gdp_norm + gni_norm) / 2).clip(0, 100)\\n",
    "        \\n",
    "        # Composite EMRI Score\\n",
    "        weights = self.config.EMRI_WEIGHTS\\n",
    "        df_emri['EMRI_Score'] = sum(\\n",
    "            df_emri[index] * weight for index, weight in weights.items()\\n",
    "        )\\n",
    "        \\n",
    "        return df_emri\\n",
    "    \\n",
    "    def create_binary_target(\\n",
    "        self, \\n",
    "        df: pd.DataFrame, \\n",
    "        threshold_percentile: int = 50\\n",
    "    ) -> Tuple[pd.DataFrame, float, Dict]:\\n",
    "        \"\"\"\\n",
    "        Create binary target based on EMRI score threshold.\\n",
    "        Returns: dataframe, threshold value, statistics dict\\n",
    "        \"\"\"\\n",
    "        df = df.copy()\\n",
    "        threshold = df['EMRI_Score'].quantile(threshold_percentile / 100)\\n",
    "        df['High_Competitiveness'] = (df['EMRI_Score'] >= threshold).astype(int)\\n",
    "        \\n",
    "        # Derived variables\\n",
    "        df['Log_GDP_Per_Capita'] = np.log1p(df['GDP_Per_Capita'])\\n",
    "        df['Log_GNI_Per_Capita'] = np.log1p(df['GNI_Per_Capita'])\\n",
    "        \\n",
    "        class_counts = df['High_Competitiveness'].value_counts().sort_index()\\n",
    "        stats = {\\n",
    "            'threshold': threshold,\\n",
    "            'n_low': class_counts[0],\\n",
    "            'n_high': class_counts[1],\\n",
    "            'pct_low': class_counts[0] / len(df) * 100,\\n",
    "            'pct_high': class_counts[1] / len(df) * 100,\\n",
    "        }\\n",
    "        \\n",
    "        return df, threshold, stats\\n",
    "    \\n",
    "    def run_pipeline(self, df_raw: pd.DataFrame) -> Tuple[pd.DataFrame, Dict]:\\n",
    "        \"\"\"Execute full feature engineering pipeline.\"\"\"\\n",
    "        numeric_cols = list(self.config.WDI_INDICATORS.values())\\n",
    "        \\n",
    "        # Step 1: KNN Imputation\\n",
    "        self.logger.info(\"Starting KNN imputation\")\\n",
    "        df_imputed = self.knn_impute_year_stratified(df_raw, numeric_cols)\\n",
    "        \\n",
    "        # Step 2: Construct EMRI indices\\n",
    "        self.logger.info(\"Constructing EMRI indices\")\\n",
    "        df_emri = self.construct_emri_indices(df_imputed)\\n",
    "        \\n",
    "        # Step 3: Create binary target\\n",
    "        self.logger.info(\"Creating binary target\")\\n",
    "        df_final, threshold, target_stats = self.create_binary_target(df_emri)\\n",
    "        \\n",
    "        # Summary statistics\\n",
    "        emri_indices = list(self.config.EMRI_WEIGHTS.keys()) + ['EMRI_Score']\\n",
    "        summary = df_final[emri_indices].describe().round(2)\\n",
    "        \\n",
    "        return df_final, {\\n",
    "            'threshold': threshold,\\n",
    "            'target_stats': target_stats,\\n",
    "            'summary': summary,\\n",
    "            'n_features': len(emri_indices)\\n",
    "        }\\n",
    "\\n",
    "\\n",
    "# Execute feature engineering\\n",
    "print(\"\\n\" + \"=\" * 80)\\n",
    "print(\"SECTION 3: FEATURE ENGINEERING\")\\n",
    "print(\"=\" * 80)\\n",
    "\\n",
    "fe_pipeline = FeatureEngineeringPipeline()\\n",
    "df_processed, fe_report = fe_pipeline.run_pipeline(df_raw)\\n",
    "\\n",
    "print(\"\\nEMRI Indices Summary:\")\\n",
    "print(f\"  Threshold (50th percentile): {fe_report['threshold']:.2f}\")\\n",
    "print(f\"  Low Competitiveness: {fe_report['target_stats']['n_low']} ({fe_report['target_stats']['pct_low']:.1f}%)\")\\n",
    "print(f\"  High Competitiveness: {fe_report['target_stats']['n_high']} ({fe_report['target_stats']['pct_high']:.1f}%)\")\\n",
    "print(\"\\nIndex Statistics:\")\\n",
    "print(fe_report['summary'].to_string())\\n",
    "\\n",
    "df_processed[['country_iso3', 'year', 'EMRI_Score', 'High_Competitiveness']].head(10)"
   ]
