    "\\n",
    "# =============================================================================\\n",
    "# Production Prediction API\\n",
    "# =============================================================================\\n",
    "class EMRIPredictor:\\n",
    "    \"\"\"\\n",
    "    Production-ready EMRI prediction API.\\n",
    "    \\n",
    "    Usage:\\n",
    "        predictor = EMRIPredictor.load('emri_production_pipeline_v5.pkl')\\n",
    "        result = predictor.predict({\\n",
    "            'DII': 75.0, 'HCI': 60.0, 'ESI': 55.0,\\n",
    "            'GEI': 70.0, 'SRI': 65.0, 'PSI': 50.0, 'SSI': 45.0\\n",
    "        })\\n",
    "    \"\"\"\\n",
    "    \\n",
    "    def __init__(self, model_artifacts: Dict):\\n",
    "        self.models = model_artifacts['models']\\n",
    "        self.stacking = model_artifacts['stacking_ensemble']\\n",
    "        self.calibrated = model_artifacts['calibrated_model']\\n",
    "        self.feature_names = model_artifacts['feature_names']\\n",
    "        self.emri_weights = model_artifacts['emri_weights']\\n",
    "        self.threshold = model_artifacts['threshold']\\n",
    "        self.metadata = model_artifacts['metadata']\\n",
    "        self.best_model_name = self.metadata['best_model']\\n",
    "        self.best_model = self.models[self.best_model_name]\\n",
    "    \\n",
    "    @classmethod\\n",
    "    def load(cls, model_path: Union[str, Path]) -> 'EMRIPredictor':\\n",
    "        \"\"\"Load predictor from serialized file.\"\"\"\\n",
    "        with open(model_path, 'rb') as f:\\n",
    "            artifacts = pickle.load(f)\\n",
    "        return cls(artifacts)\\n",
    "    \\n",
    "    def predict_single(\\n",
    "        self, \\n",
    "        features: Dict[str, float],\\n",
    "        use_ensemble: bool = True\\n",
    "    ) -> Dict:\\n",
    "        \"\"\"\\n",
    "        Predict for a single country/year.\\n",
    "        \\n",
    "        Args:\\n",
    "            features: Dictionary with EMRI index values (DII, HCI, etc.)\\n",
    "            use_ensemble: If True, use stacking ensemble; else use best model\\n",
    "        \"\"\"\\n",
    "        # Validate features\\n",
    "        missing = set(self.feature_names) - set(features.keys())\\n",
    "        if missing:\\n",
    "            raise ValueError(f\"Missing features: {missing}\")\\n",
    "        \\n",
    "        # Create feature array\\n",
    "        X = np.array([[features[f] for f in self.feature_names]])\\n",
    "        \\n",
    "        # Get predictions\\n",
    "        if use_ensemble:\\n",
    "            model = self.stacking\\n",
    "            model_name = 'Stacking Ensemble'\\n",
    "        else:\\n",
    "            model = self.best_model\\n",
    "            model_name = self.best_model_name\\n",
    "        \\n",
    "        proba = model.predict_proba(X)[0, 1]\\n",
    "        prediction = 1 if proba >= 0.5 else 0\\n",
    "        \\n",
    "        # Individual model predictions for comparison\\n",
    "        individual_predictions = {\\n",
    "            name: float(m.predict_proba(X)[0, 1])\\n",
    "            for name, m in self.models.items()\\n",
    "        }\\n",
    "        \\n",
    "        # Calculate EMRI score\\n",
    "        emri_score = sum(features[idx] * weight for idx, weight in self.emri_weights.items())\\n",
    "        \\n",
    "        return {\\n",
    "            'emri_score': float(emri_score),\\n",
    "            'high_competitiveness_probability': float(proba),\\n    "            'high_competitiveness_prediction': int(prediction),\\n",
    "            'model_used': model_name,\\n",
    "            'threshold': float(self.threshold),\\n",
    "            'individual_model_probabilities': individual_predictions,\\n",
    "            'input_features': features\\n",
    "        }\\n",
    "    \\n",
    "    def predict_batch(\\n",
    "        self, \\n",
    "        df: pd.DataFrame,\\n",
    "        use_ensemble: bool = True\\n",
    "    ) -> pd.DataFrame:\\n",
    "        \"\"\"Predict for batch of records.\"\"\"\\n",
    "        X = df[self.feature_names].values\\n",
    "        \\n",
    "        if use_ensemble:\\n",
    "            proba = self.stacking.predict_proba(X)[:, 1]\\n",
    "        else:\\n",
    "            proba = self.best_model.predict_proba(X)[:, 1]\\n",
    "        \\n",
    "        df_result = df.copy()\\n",
    "        df_result['High_Competitiveness_Prob'] = proba\\n",
    "        df_result['High_Competitiveness_Pred'] = (proba >= 0.5).astype(int)\\n",
    "        \\n",
    "        return df_result\\n",
